+        CallLogType.Missed => CallOutcome.Missed,
+        CallLogType.Rejected => CallOutcome.Rejected,
+        CallLogType.Blocked => CallOutcome.Blocked,
+        CallLogType.Voicemail => CallOutcome.Voicemail,
+        _ => CallOutcome.Unknown
